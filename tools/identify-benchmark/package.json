{
  "name": "identify-benchmark",
  "version": "0.1.0",
  "private": true,
  "description": "Benchmarks the app's product identification (Open Food Facts + Claude) on real Mexican products.",
  "type": "module",
  "engines": {
    "node": ">=22.15"
  },
  "scripts": {
    "testset": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ../../app/scripts/test-resolve.mjs src/build-testset.ts",
    "bench": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ../../app/scripts/test-resolve.mjs src/bench.ts",
    "report": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ../../app/scripts/test-resolve.mjs src/bench.ts --report-only",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ../../app/scripts/test-resolve.mjs --test \"src/**/*.test.ts\"",
    "compare": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/compare.ts",
    "add-products": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ../../app/scripts/test-resolve.mjs src/add-products.ts",
    "diff": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON src/diff.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.3.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "~6.0.3"
  }
}
