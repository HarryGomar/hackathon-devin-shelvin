# Copy to .env and fill in. Variables starting with EXPO_PUBLIC_ are bundled into the app.

# Backend: "mock" (default) uses the in-app mock API; "live" calls EXPO_PUBLIC_API_BASE_URL.
# On an iPhone, use this PC's Wi-Fi address instead of localhost, e.g. http://192.168.1.20:8791.
# With API_MODE=live the backend runs page search, scraper builds and scrapes. Identification still runs on the
# phone (IDENTIFY_MODE below; the backend has no /identify). SEARCH_MODE is ignored.
EXPO_PUBLIC_API_MODE=mock
EXPO_PUBLIC_API_BASE_URL=http://localhost:8791
# Shared team token, sent as "Authorization: Bearer <token>" on every request (the backend's API_TOKEN).
# Leave empty for a backend with auth turned off. It ships inside the app: a speed bump, not real security.
EXPO_PUBLIC_API_TOKEN=
# Which builder the MOCK backend pretends to run: "devin" (default) or "claude_code". The live backend picks its
# builder with its own AGENT setting, and the app shows whichever ran each build.
EXPO_PUBLIC_MOCK_AGENT=devin

# Product identification (in both API modes): "mock" (default) or "live" (Open Food Facts + Claude from the phone, needs the key below).
EXPO_PUBLIC_IDENTIFY_MODE=mock
# Only while the backend is mocked (API_MODE=mock): page search: "mock" (default) or "claude" (Claude web search finds real Mexican
# store pages from inside the app; scrapers stay mocked; needs the key below). COST: roughly US$0.20-0.50 and
# 30-90 s per search (Claude Opus 5.5 tokens + up to 6-8 web searches at US$0.01 each). Ignored when API_MODE=live.
EXPO_PUBLIC_SEARCH_MODE=mock
# Needed for IDENTIFY_MODE=live (and SEARCH_MODE=claude). WARNING: this key ships inside the app. Use a key with a spending limit.
EXPO_PUBLIC_ANTHROPIC_API_KEY=
